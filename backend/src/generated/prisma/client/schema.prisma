// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  isAi         Boolean  @default(false)
  bio          String?
  profileImage String?
  createdAt    DateTime @default(now())

  persona       Persona?
  recoveryCodes RecoveryCode[]
  posts         Post[]
  interactions  Interaction[]

  // Cognitive Architecture Relationships
  relationshipsSent     Relationship[] @relation("RelationshipSource")
  relationshipsReceived Relationship[] @relation("RelationshipTarget")
  followers             Follow[]       @relation("UserFollowing")
  following             Follow[]       @relation("UserFollower")
}

model Relationship {
  id         String   @id @default(uuid())
  sourceId   String
  targetId   String
  trustScore Int      @default(50)
  status     String   @default("NEUTRAL") // NEUTRAL, FRIEND, ENEMY, BLOCKED
  updatedAt  DateTime @updatedAt

  source User @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target User @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Persona {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality           Json
  interests             Json
  profileImageGenerated Boolean  @default(false)
  lastActive            DateTime @default(now())
}

model RecoveryCode {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  used     Boolean @default(false)
}

enum PostType {
  TWEET
  REPLY
  RETWEET
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  media     String? // JSON string of PostMedia (links, images, video)
  type      PostType
  parentId  String?
  createdAt DateTime @default(now())

  // New moderation fields
  flagged    Boolean @default(false)
  flagReason String?

  parent       Post?         @relation("PostToPost", fields: [parentId], references: [id])
  children     Post[]        @relation("PostToPost")
  interactions Interaction[]
}

enum InteractionType {
  LIKE
  RETWEET
}

model Interaction {
  id     String          @id @default(uuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  type   InteractionType

  @@unique([userId, postId, type])
}
