// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  isAi          Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  bio           String?
  profileImage  String?
  createdAt     DateTime @default(now())

  persona       Persona?
  recoveryCodes RecoveryCode[]
  posts         Post[]
  interactions  Interaction[]
  reports       Report[]

  // Cognitive Architecture Relationships
  relationshipsSent     Relationship[] @relation("RelationshipSource")
  relationshipsReceived Relationship[] @relation("RelationshipTarget")
  followers             Follow[]       @relation("UserFollowing")
  following             Follow[]       @relation("UserFollower")
}

// §5.4: Converted status from untyped String to proper enum
enum RelationshipStatus {
  NEUTRAL
  FRIEND
  ENEMY
  BLOCKED
}

model Relationship {
  id         String             @id @default(uuid())
  sourceId   String
  targetId   String
  trustScore Int                @default(50)
  status     RelationshipStatus @default(NEUTRAL)
  updatedAt  DateTime           @updatedAt

  source     User     @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target     User     @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  // §5.1: Index for getFollowingFeed query
  @@index([followerId])
}

model Persona {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality           Json
  interests             Json
  profileImageGenerated Boolean  @default(false)
  lastActive            DateTime @default(now())
}

model RecoveryCode {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  used     Boolean @default(false)
}

enum PostType {
  TWEET
  REPLY
  RETWEET
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  // §5.2: Changed from String to Json for proper type handling
  media     Json?
  type      PostType
  parentId  String?
  createdAt DateTime @default(now())

  // Moderation fields
  flagged    Boolean @default(false)
  flagReason String?

  parent         Post?           @relation("PostToPost", fields: [parentId], references: [id])
  children       Post[]          @relation("PostToPost")
  interactions   Interaction[]
  reports        Report[]
  moderationLogs ModerationLog[]

  // §5.1: Index for feed queries (flagged + parentId + createdAt)
  @@index([flagged, parentId, createdAt])
  @@index([userId, createdAt])
}

enum InteractionType {
  LIKE
  RETWEET
  SAVE
}

model Interaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      InteractionType
  // §5.5: Added createdAt for chronological sorting of notifications
  createdAt DateTime        @default(now())

  @@unique([userId, postId, type])
  // §5.1: Index for notification queries
  @@index([postId])
}

// ─── Reporting & Moderation ──────────────────────────────────────────────

model Report {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("PENDING") // PENDING | REVIEWED | DISMISSED
  createdAt  DateTime @default(now())

  @@unique([reporterId, postId])
  @@index([status, createdAt])
}

model ModerationLog {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  action    String   // AUTO_FLAG | MANUAL_APPROVE | MANUAL_FLAG | REPORT_FLAG
  reason    String?
  adminId   String?  // null for auto-moderation
  createdAt DateTime @default(now())

  @@index([createdAt])
}

